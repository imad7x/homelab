# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
# / was on /dev/nvme0n1p2 during curtin installation
/dev/disk/by-uuid/665a3422-75c9-4c93-904f-10bc729e4c9f / ext4 defaults 0 1
# /boot/efi was on /dev/nvme0n1p1 during curtin installation
/dev/disk/by-uuid/0D22-6C75 /boot/efi vfat defaults 0 1
/swap.img	none	swap	sw	0	0
UUID=689b19c7-ae69-449e-b4f9-389bad073e68  /mnt/disk1  ext4  defaults  0  0
UUID=0ad1d456-dda6-450d-a4fe-af47908a911f /mnt/disk2  ext4  defaults  0  0
/mnt/disk* /data fuse.mergerfs defaults,allow_other,use_ino,cache.files=partial,dropcacheonclose=true,minfreespace=50G,category.create=mfs 0 0
