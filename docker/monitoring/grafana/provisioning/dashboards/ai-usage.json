    {
      "type": "timeseries",
      "title": "Tokens per day, by pool",
      "description": "Input, output and thinking tokens per day (IST), stacked by pool.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ai-usage"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "ai-usage"
          },
          "queryType": "table",
          "queryText": "SELECT ((c.t + 19800) / 86400) * 86400 - 19800 AS time, p.label AS pool, SUM(COALESCE(c.input,0) + COALESCE(c.cache_write,0) + COALESCE(c.cache_read,0) + COALESCE(c.output,0) + COALESCE(c.thinking,0)) AS tokens FROM calls c JOIN pools p ON p.code = c.pool WHERE c.t >= $__from / 1000 AND c.t <= $__to / 1000 GROUP BY 1, 2 ORDER BY 1",
          "rawQueryText": "SELECT ((c.t + 19800) / 86400) * 86400 - 19800 AS time, p.label AS pool, SUM(COALESCE(c.input,0) + COALESCE(c.cache_write,0) + COALESCE(c.cache_read,0) + COALESCE(c.output,0) + COALESCE(c.thinking,0)) AS tokens FROM calls c JOIN pools p ON p.code = c.pool WHERE c.t >= $__from / 1000 AND c.t <= $__to / 1000 GROUP BY 1, 2 ORDER BY 1",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
