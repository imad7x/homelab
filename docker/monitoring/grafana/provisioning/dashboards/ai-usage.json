{
  "uid": "ai-usage",
  "title": "AI Usage",
  "description": "Every AI call on the lab, from the gateway's ledger: limits left in each plan, tokens by pool, and which app and model used them.",
  "tags": [
    "ai",
    "homelab"
  ],
  "timezone": "browser",
  "weekStart": "monday",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Limits",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Left in each limit now",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ai-usage"
      },
      "description": "Newest reading per plan and window, taken every 10 minutes with each CLI's own usage command (costs no tokens). The subscription's 5-hour window is shared with chats.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "ai-usage"
          },
          "queryType": "table",
          "queryText": "SELECT p.label || CASE l.win WHEN '5h' THEN ' \u00b7 5-hour' ELSE ' \u00b7 ' || l.win END AS name, 100 - l.used_pct AS left_pct FROM limits l JOIN pools p ON p.code = l.pool WHERE l.t = (SELECT max(t) FROM limits x WHERE x.pool = l.pool AND x.win = l.win) ORDER BY p.ord, l.win",
          "rawQueryText": "SELECT p.label || CASE l.win WHEN '5h' THEN ' \u00b7 5-hour' ELSE ' \u00b7 ' || l.win END AS name, 100 - l.used_pct AS left_pct FROM limits l JOIN pools p ON p.code = l.pool WHERE l.t = (SELECT max(t) FROM limits x WHERE x.pool = l.pool AND x.win = l.win) ORDER BY p.ord, l.win",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "displayName": "${__data.fields.name}",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 10
              },
              {
                "color": "#0ca30c",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 24
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 10,
        "h": 7
      }
    },
    {
      "type": "table",
      "title": "When each limit resets",
      "description": "Times from the subscription CLI are as it prints them; Google's are converted to IST.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ai-usage"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "ai-usage"
          },
          "queryType": "table",
          "queryText": "SELECT p.label || CASE l.win WHEN '5h' THEN ' \u00b7 5-hour' ELSE ' \u00b7 ' || l.win END AS \"Limit\", ROUND(l.used_pct, 1) AS \"Used %\", CASE WHEN l.resets LIKE '____-__-__T%' THEN strftime('%Y-%m-%d %H:%M IST', l.resets, '+330 minutes') ELSE l.resets END AS \"Resets\" FROM limits l JOIN pools p ON p.code = l.pool WHERE l.t = (SELECT max(t) FROM limits x WHERE x.pool = l.pool AND x.win = l.win) ORDER BY p.ord, l.win",
          "rawQueryText": "SELECT p.label || CASE l.win WHEN '5h' THEN ' \u00b7 5-hour' ELSE ' \u00b7 ' || l.win END AS \"Limit\", ROUND(l.used_pct, 1) AS \"Used %\", CASE WHEN l.resets LIKE '____-__-__T%' THEN strftime('%Y-%m-%d %H:%M IST', l.resets, '+330 minutes') ELSE l.resets END AS \"Resets\" FROM limits l JOIN pools p ON p.code = l.pool WHERE l.t = (SELECT max(t) FROM limits x WHERE x.pool = l.pool AND x.win = l.win) ORDER BY p.ord, l.win",
          "timeColumns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "noValue": "Nothing in this range"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": []
        }
      },
      "id": 3,
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 14,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Limits used over time",
      "description": "Each line is one plan window; it drops back when the window resets.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "ai-usage"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "ai-usage"
          },
          "queryType": "table",
          "queryText": "SELECT l.t AS time, p.label || CASE l.win WHEN '5h' THEN ' \u00b7 5-hour' ELSE ' \u00b7 ' || l.win END AS series, l.used_pct AS used FROM limits l JOIN pools p ON p.code = l.pool WHERE l.t >= $__from / 1000 AND l.t <= $__to / 1000 ORDER BY l.t",
          "rawQueryText": "SELECT l.t AS time, p.label || CASE l.win WHEN '5h' THEN ' \u00b7 5-hour' ELSE ' \u00b7 ' || l.win END AS series, l.used_pct AS used FROM limits l JOIN pools p ON p.code = l.pool WHERE l.t >= $__from / 1000 AND l.t <= $__to / 1000 ORDER BY l.t",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "series"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "${__field.labels.series}",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "stepAfter",
            "axisBorderShow": false,
            "barAlignment": 0,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMax": 100
          },
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Pro.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Gemini.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*GPT.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Pro \u00b7 week"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
